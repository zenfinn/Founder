# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Stripe (required for payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_FOUNDER_PRO_STRIPE_PRICE_OR_PRODUCT_ID=
STRIPE_FOUNDER_PRO_ONBOARDING_COUPON_ID=QVOYCIwX

# App URL (required in production – used for OG tags, Stripe redirects, sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email / SMTP (optional – verification & payment notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Founder <no-reply@founder.example>
ADMIN_EMAIL=admin@founder.example
