# =============================================================================
# Founder – Environment Variables
# =============================================================================
# Lokal: Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
# Production (Vercel): Project Settings → Environment Variables
# Domain: https://www.joinfounder.forum
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Stripe (required for payments)
# Dashboard → Developers → API keys / Webhooks / Products
# Webhook-Endpoint (Production): https://www.joinfounder.forum/api/stripe/webhook
# Events: checkout.session.completed, invoice.payment_succeeded, customer.subscription.deleted
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_FOUNDER_PRO_STRIPE_PRICE_OR_PRODUCT_ID=prod_UYfGh1P7PJkCin
STRIPE_FOUNDER_PRO_PRODUCT_ID=prod_UYfGh1P7PJkCin
STRIPE_FOUNDER_PRO_ONBOARDING_COUPON_ID=QVOYCIwX

# -----------------------------------------------------------------------------
# App URL (required in production)
# Wird genutzt für: OG-Tags, Sitemap, Stripe Redirects, Referral-Links, E-Mails
# Lokal: http://localhost:3000
# Production: https://www.joinfounder.forum
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://www.joinfounder.forum

# -----------------------------------------------------------------------------
# Email / SMTP (verification & payment notifications)
# Gmail: 2FA aktivieren, dann App-Passwort unter https://myaccount.google.com/apppasswords
# Ohne SMTP werden E-Mails nur geloggt, nicht versendet (lib/email.js).
# -----------------------------------------------------------------------------
ADMIN_EMAIL=joinfounder@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Founder <no-reply@joinfounder.forum>

# -----------------------------------------------------------------------------
# Analytics (optional)
# Google Analytics 4 Measurement ID
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
